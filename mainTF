terraform {
  required_providers {
    aws = {
      source = "hashicorp/aws"
      version = "5.90.1"
    }
  }
}

provider "aws" {
  region = "eu-north-1"
}

resource "aws_s3_bucket" "demo-0109889" {
  bucket = "my-tf3333-test-bucket-1980"
  
}

resource "aws_s3_object" "demo-2" {
  bucket = aws_s3_bucket.demo-0109889.bucket
  source = "./myfile.txt"
  key ="mydata.txt"
}
